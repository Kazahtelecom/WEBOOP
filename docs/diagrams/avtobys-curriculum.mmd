classDiagram
    direction TB

    %% Неделя 1: Инкапсуляция
    class Route {
        -str _route_number
        -Decimal _base_fare
        -list~str~ _stops
        +str route_number
        +Decimal base_fare
        +list~str~ stops
    }

    class Bus {
        -str _plate_number
        -int _capacity
        -int _current_passengers
        -Route _route
        +str plate_number
        +int capacity
        +int current_passengers
        +Route route
        +assign_route(Route route) void
        +board_passengers(int count) void
        +leave_passengers(int count) void
    }

    class TransitCard {
        -str _card_id
        -Decimal _balance
        -Decimal _discount_rate
        -bool _is_blocked
        +str card_id
        +Decimal balance
        +Decimal discount_rate
        +bool is_blocked
        +top_up(Decimal amount) void
        +pay(Decimal fare) Decimal
        +block(str reason) void
        +unblock() void
    }

    class SingleTripTicket {
        -str _ticket_code
        -Decimal _price
        -datetime _issued_at
        -bool _is_validated
        -Bus _validated_bus
        +str ticket_code
        +Decimal price
        +datetime issued_at
        +bool is_validated
        +Bus validated_bus
        +validate(Bus bus, datetime current_time) void
    }

    Bus *-- "0..1" Route : обслуживает
    SingleTripTicket ..> Bus : валидируется в

    %% Неделя 2: Композиция тарифов
    class FareCalculator {
        -Decimal _base_rate
        -DiscountPolicy _discount
        -ZoneMultiplierPolicy _zone
        +calculate() Decimal
        +set_discount(DiscountPolicy policy) void
    }

    class DiscountPolicy {
        <<interface>>
        +apply(Decimal amount)* Decimal
    }
    class StudentDiscount {
        +apply(Decimal amount) Decimal
    }
    class StandardDiscount {
        +apply(Decimal amount) Decimal
    }

    FareCalculator *-- "1" DiscountPolicy : композирует (Composition)
    DiscountPolicy <|.. StudentDiscount : реализует
    DiscountPolicy <|.. StandardDiscount : реализует

    %% Неделя 3: Полиморфизм платежей
    class PaymentMethod {
        <<Protocol / ABC>>
        +process_payment(Decimal amount)* PaymentReceipt
    }

    class CardPayment {
        -TransitCard card
        +process_payment(Decimal amount) PaymentReceipt
    }

    class QRPayment {
        -str qr_token
        +process_payment(Decimal amount) PaymentReceipt
    }

    class ValidatorDevice {
        -str _device_id
        -FareCalculator _fare_calculator
        +process_ride(PaymentMethod payment) RideReceipt
    }

    PaymentMethod <|.. CardPayment : полиморфно реализует
    PaymentMethod <|.. QRPayment : полиморфно реализует
    ValidatorDevice --> PaymentMethod : использует без if/elif (Полиморфизм)
    ValidatorDevice *-- FareCalculator : использует
